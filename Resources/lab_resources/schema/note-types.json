{
  "schema_version": "1.0.0",
  "max_attachment_mb": 10,
  "open_attachment_extensions": [
    "png",
    "jpg",
    "jpeg",
    "svg",
    "gif",
    "webp",
    "pdf",
    "csv",
    "tsv",
    "txt",
    "json",
    "md",
    "html"
  ],
  "raw_extensions_disallowed": [
    "czi",
    "lif",
    "nd2",
    "fcs",
    "fastq",
    "fq",
    "gz",
    "bam",
    "bai",
    "cram",
    "sam",
    "vcf",
    "raw",
    "mzml",
    "d",
    "h5",
    "h5ad",
    "rds",
    "tif",
    "tiff"
  ],
  "untyped_allowed": [],
  "id_patterns": {
    "daily": "^\\d{4}-\\d{2}-\\d{2}$",
    "prefixed": "^(EXP|PRT|SMP|MAT|INS|DATA|CODE|EVT)-([A-Z]{2,4})-(\\d{8})-(\\d{2})$",
    "slug": "^[A-Za-z0-9][A-Za-z0-9 _.()-]*$"
  },
  "attachment_name_pattern": "^(EXP|PRT|SMP|MAT|INS|DATA|CODE|EVT)-[A-Z]{2,4}-\\d{8}-\\d{2}_[A-Za-z0-9-]+_\\d{8}\\.[A-Za-z0-9]+$",
  "core_required": [
    "type",
    "id",
    "created",
    "updated",
    "status",
    "owner",
    "confidentiality",
    "license",
    "ai_assisted"
  ],
  "date_fields": [
    "created",
    "updated",
    "start_date",
    "end_date",
    "signed_off_on",
    "collection_date",
    "generated_on",
    "str_authenticated_on",
    "mycoplasma_tested_on",
    "customised_on",
    "original_date",
    "date"
  ],
  "enums": {
    "confidentiality": [
      "internal",
      "confidential",
      "embargoed",
      "public"
    ],
    "outcome": [
      "pending",
      "success",
      "partial",
      "failed",
      "negative"
    ],
    "material_kind": [
      "cell_line",
      "antibody",
      "reagent",
      "kit",
      "plasmid",
      "primer",
      "organism_strain"
    ],
    "source_kind": [
      "human",
      "animal",
      "cell_line",
      "other"
    ],
    "event_type": [
      "journal_club",
      "wow",
      "conference",
      "talk",
      "lab_meeting"
    ],
    "biosafety_level": [
      "BSL-1",
      "BSL-2",
      "BSL-3"
    ],
    "procedures": [
      "maintenance",
      "thawing",
      "passaging",
      "counting",
      "freezing"
    ],
    "okf_export": [
      "allowed"
    ]
  },
  "link_property_types": {
    "projects": "project",
    "protocols": "protocol",
    "samples": "sample",
    "materials": "material",
    "instruments": "instrument",
    "data_refs": "data_ref",
    "code_refs": "code_ref",
    "parent_sample": "sample",
    "supersedes": "protocol",
    "literature": "literature"
  },
  "removed_plugin_terms": {
    "calendar": [
      "Calendar plugin",
      "calendar:"
    ],
    "omnisearch": [
      "Omnisearch",
      "omnisearch"
    ],
    "obsidian-pandoc-reference-list": [
      "Pandoc Reference List",
      "obsidian-pandoc-reference-list"
    ],
    "obsidian-icon-folder": [
      "Iconize",
      "Icon Folder",
      "obsidian-icon-folder"
    ],
    "ob-table-enhancer": [
      "Table Enhancer",
      "ob-table-enhancer"
    ],
    "inline-admonitions": [
      "Inline Admonitions",
      "inline-admonitions",
      "inlineAdmonitions"
    ],
    "obsidian-mind-map": [
      "Mind Map plugin",
      "obsidian-mind-map"
    ],
    "obsidian-local-rest-api": [
      "Local REST API",
      "obsidian-local-rest-api"
    ],
    "terminal": [
      "Terminal plugin",
      "terminal:"
    ],
    "x-post-saver": [
      "X Post Saver",
      "x-post-saver"
    ],
    "obsidian-google-calendar": [
      "Google Calendar",
      "obsidian-google-calendar"
    ]
  },
  "removed_plugin_exempt_files": [
    "CHANGELOG.md",
    "UPGRADE.md",
    "Resources/lab_resources/Plugin register.md",
    "Resources/lab_resources/Feature preservation register.md"
  ],
  "groups": {
    "care": [
      "ethics_approval",
      "consent_scope",
      "permitted_uses",
      "data_steward",
      "community_source",
      "benefit_sharing",
      "sharing_restrictions"
    ],
    "animal": [
      "iaec_approval",
      "humane_endpoints",
      "three_rs",
      "species_strain",
      "animal_count"
    ]
  },
  "common_conditional": [
    {
      "when": {
        "ai_assisted": [
          true
        ]
      },
      "require": [
        "ai_note"
      ],
      "rule": "FM003"
    },
    {
      "when": {
        "human_or_community_data": [
          true
        ]
      },
      "require_group": "care",
      "rule": "CA001"
    },
    {
      "when": {
        "animal_study": [
          true
        ]
      },
      "require_group": "animal",
      "rule": "AN001"
    },
    {
      "when": {
        "biosafety_level": [
          "BSL-2",
          "BSL-3"
        ]
      },
      "require": [
        "ibsc_approval"
      ],
      "rule": "BS001"
    }
  ],
  "types": {
    "daily": {
      "id_kind": "daily",
      "folder": "daily_notes",
      "status": [
        "open",
        "done"
      ],
      "required": [],
      "required_keys": [
        "projects"
      ],
      "conditional": []
    },
    "experiment": {
      "id_kind": "prefixed",
      "id_prefix": "EXP",
      "folder": "Experiments",
      "status": [
        "planned",
        "in-progress",
        "completed",
        "signed-off",
        "archived"
      ],
      "required": [
        "experiment_type",
        "title",
        "start_date",
        "outcome",
        "template_id",
        "template_version"
      ],
      "required_keys": [
        "projects",
        "protocols",
        "samples",
        "materials",
        "data_refs",
        "code_refs",
        "review_requested",
        "signed_off_by",
        "signed_off_on"
      ],
      "conditional": [
        {
          "when": {
            "status": [
              "completed",
              "signed-off",
              "archived"
            ]
          },
          "require": [
            "projects",
            "end_date"
          ],
          "rule": "FM003"
        },
        {
          "when": {
            "outcome": [
              "failed",
              "negative"
            ]
          },
          "require": [
            "outcome_reason"
          ],
          "rule": "FM003"
        },
        {
          "when": {
            "status": [
              "signed-off"
            ]
          },
          "require": [
            "signed_off_by",
            "signed_off_on"
          ],
          "rule": "SO001"
        },
        {
          "when": {
            "experiment_type": [
              "E1",
              "E2"
            ]
          },
          "equals": {
            "animal_study": true
          },
          "rule": "AN001"
        },
        {
          "when": {
            "experiment_type": [
              "A1"
            ]
          },
          "equals": {
            "human_or_community_data": true
          },
          "rule": "CA001"
        },
        {
          "when": {
            "experiment_type": [
              "A1",
              "A2",
              "A3",
              "B4",
              "B5",
              "B6",
              "E1",
              "E2"
            ]
          },
          "require": [
            "biosafety_level"
          ],
          "rule": "BS001"
        }
      ]
    },
    "protocol": {
      "id_kind": "prefixed",
      "id_prefix": "PRT",
      "folder": "Protocols",
      "status": [
        "draft",
        "validated",
        "active",
        "superseded",
        "retired"
      ],
      "required": [
        "protocol_family",
        "version"
      ],
      "required_keys": [
        "supersedes"
      ],
      "conditional": [
        {
          "when": {},
          "require": [
            "biosafety_level"
          ],
          "rule": "BS001"
        }
      ]
    },
    "sample": {
      "id_kind": "prefixed",
      "id_prefix": "SMP",
      "folder": "Samples",
      "status": [
        "active",
        "archived"
      ],
      "required": [
        "sample_code",
        "sample_type",
        "source_kind",
        "collection_date",
        "storage_location"
      ],
      "required_keys": [
        "projects",
        "parent_sample"
      ],
      "conditional": [
        {
          "when": {
            "source_kind": [
              "human"
            ]
          },
          "equals": {
            "human_or_community_data": true
          },
          "rule": "CA002"
        }
      ]
    },
    "material": {
      "id_kind": "prefixed",
      "id_prefix": "MAT",
      "folder": "Materials",
      "status": [
        "active",
        "archived"
      ],
      "required": [
        "material_kind"
      ],
      "required_keys": [
        "supplier",
        "catalog_no",
        "lot_no",
        "rrid"
      ],
      "conditional": []
    },
    "instrument": {
      "id_kind": "prefixed",
      "id_prefix": "INS",
      "folder": "Materials",
      "status": [
        "active",
        "archived"
      ],
      "required": [
        "model",
        "location"
      ],
      "required_keys": [],
      "conditional": []
    },
    "data_ref": {
      "id_kind": "prefixed",
      "id_prefix": "DATA",
      "folder": "Data",
      "status": [
        "active",
        "archived"
      ],
      "required": [
        "description"
      ],
      "required_keys": [
        "projects",
        "persistent_id"
      ],
      "conditional": [
        {
          "when": {},
          "require": [
            "location",
            "format",
            "size",
            "checksum",
            "steward",
            "access_conditions"
          ],
          "rule": "DR001"
        }
      ]
    },
    "code_ref": {
      "id_kind": "prefixed",
      "id_prefix": "CODE",
      "folder": "Data",
      "status": [
        "active",
        "archived"
      ],
      "required": [],
      "required_keys": [
        "projects"
      ],
      "conditional": [
        {
          "when": {},
          "require": [
            "repository",
            "entry_point"
          ],
          "rule": "DR002"
        },
        {
          "when": {},
          "require_any": [
            "commit",
            "version_tag"
          ],
          "rule": "DR002"
        }
      ]
    },
    "project": {
      "id_kind": "slug",
      "folder": "Projects/Auto_summary",
      "status": [
        "active",
        "paused",
        "completed"
      ],
      "required": [
        "project_tag"
      ],
      "required_keys": [
        "members",
        "pi"
      ],
      "conditional": []
    },
    "concept": {
      "id_kind": "slug",
      "folder": "Concepts",
      "status": [
        "active",
        "archived"
      ],
      "required": [],
      "required_keys": [
        "search_terms"
      ],
      "conditional": []
    },
    "literature": {
      "id_kind": "slug",
      "folder": "Zotero_PDF_notes",
      "status": [
        "unread",
        "read",
        "archived"
      ],
      "required": [
        "citekey"
      ],
      "required_keys": [
        "doi"
      ],
      "conditional": []
    },
    "event": {
      "id_kind": "prefixed",
      "id_prefix": "EVT",
      "folder": "Events",
      "status": [
        "planned",
        "done"
      ],
      "required": [
        "event_type",
        "date"
      ],
      "required_keys": [],
      "conditional": []
    },
    "index": {
      "id_kind": "slug",
      "status": [
        "active",
        "archived"
      ],
      "required": [],
      "required_keys": [],
      "conditional": []
    },
    "guide": {
      "id_kind": "slug",
      "status": [
        "active",
        "archived"
      ],
      "required": [],
      "required_keys": [],
      "conditional": []
    },
    "settings": {
      "id_kind": "slug",
      "status": [
        "active",
        "archived"
      ],
      "required": [],
      "required_keys": [],
      "conditional": []
    }
  },
